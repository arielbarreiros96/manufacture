<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <record model="qc.test" id="qc_test_formula_demo">
        <field name="name">Formula Test (demo)</field>
        <field name="type">generic</field>
        <field name="active" eval="True" />
    </record>

    <!-- Formula question: Check if value is between 5 and 15 -->
    <record model="qc.test.question" id="qc_test_question_formula_1">
        <field name="name">Value in range</field>
        <field name="test" ref="qc_test_formula_demo" />
        <field name="type">formula</field>
        <field name="formula_code">value &gt;= 5 and value &lt;= 15</field>
        <field name="sequence">10</field>
    </record>

    <!-- Formula question: even number -->
    <record model="qc.test.question" id="qc_test_question_formula_2">
        <field name="name">Even value</field>
        <field name="test" ref="qc_test_formula_demo" />
        <field name="type">formula</field>
        <field name="formula_code">line.quantitative_value % 2 == 0</field>
        <field name="sequence">20</field>
    </record>

    <!-- Traditional qualitative question for comparison -->
    <record model="qc.test.question" id="qc_test_question_qualitative">
        <field name="name">Overall quality</field>
        <field name="test" ref="qc_test_formula_demo" />
        <field name="type">qualitative</field>
        <field name="sequence">40</field>
    </record>
    <record model="qc.test.question.value" id="qc_test_question_value_1">
        <field name="name">Good</field>
        <field name="ok" eval="True" />
        <field name="test_line" ref="qc_test_question_qualitative" />
    </record>
    <record model="qc.test.question.value" id="qc_test_question_value_2">
        <field name="name">Bad</field>
        <field name="ok" eval="False" />
        <field name="test_line" ref="qc_test_question_qualitative" />
    </record>

    <!-- Traditional quantitative question for comparison -->
    <record model="qc.test.question" id="qc_test_question_quantitative">
        <field name="name">Size</field>
        <field name="test" ref="qc_test_formula_demo" />
        <field name="type">quantitative</field>
        <field name="min_value" eval="1.0" />
        <field name="max_value" eval="10.0" />
        <field name="uom_id" ref="uom.product_uom_unit" />
        <field name="sequence">50</field>
    </record>
</odoo>

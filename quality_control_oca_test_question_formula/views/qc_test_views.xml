<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Extend the QC Test Question form view -->
    <record id="qc_test_question_form_view_formula" model="ir.ui.view">
        <field name="name">qc.test.question.form.formula</field>
        <field name="model">qc.test.question</field>
        <field name="inherit_id" ref="quality_control_oca.qc_test_question_form_view" />
        <field name="arch" type="xml">
            <field name="type" position="after">
                <group name="formula_section" invisible="type != 'formula'">
                    <!-- Example: value >= 5 and value <= 10 -->
                    <field
                        name="formula_code"
                        widget="ace"
                        options="{'mode': 'python'}"
                        string="Formula (Python)"
                        placeholder="value &gt;= 5 and value &lt;= 10"
                        required="type == 'formula'"
                        colspan="4"
                    />
                </group>
            </field>
        </field>
    </record>
</odoo>
